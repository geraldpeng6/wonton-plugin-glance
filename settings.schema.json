{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "x-wonton-order": ["city", "hour_format", "units"],
  "properties": {
    "city": {
      "type": "string",
      "default": "北京, 中国",
      "maxLength": 64,
      "x-wonton-title": { "zh": "天气城市", "en": "Weather city", "zh-Hant": "天氣城市", "ja": "天気の都市" },
      "x-wonton-description": {
        "zh": "天气部件显示的城市，写“城市, 国家”，如“上海, 中国”；清空后回到默认",
        "en": "City shown by the weather widget, as \"City, Country\" (open-meteo geocoding)",
        "zh-Hant": "天氣部件顯示的城市，寫「城市, 國家」，如「台北, 台灣」；清空後回到預設",
        "ja": "天気ウィジェットに表示する都市（「都市, 国」の形式、open-meteo のジオコーディング）"
      }
    },
    "hour_format": {
      "type": "string",
      "enum": ["12h", "24h"],
      "default": "24h",
      "x-wonton-title": { "zh": "小时制", "en": "Hour format", "zh-Hant": "小時制", "ja": "時刻の形式" },
      "x-wonton-enum-titles": {
        "12h": { "zh": "12 小时制", "en": "12-hour", "zh-Hant": "12 小時制", "ja": "12時間制" },
        "24h": { "zh": "24 小时制", "en": "24-hour", "zh-Hant": "24 小時制", "ja": "24時間制" }
      }
    },
    "units": {
      "type": "string",
      "enum": ["metric", "imperial"],
      "default": "metric",
      "x-wonton-title": { "zh": "温度单位", "en": "Temperature units", "zh-Hant": "溫度單位", "ja": "温度の単位" },
      "x-wonton-enum-titles": {
        "metric": { "zh": "摄氏度（℃）", "en": "Celsius", "zh-Hant": "攝氏（℃）", "ja": "摂氏（℃）" },
        "imperial": { "zh": "华氏度（℉）", "en": "Fahrenheit", "zh-Hant": "華氏（℉）", "ja": "華氏（℉）" }
      }
    }
  }
}
